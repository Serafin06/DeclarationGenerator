# Szablon konfiguracji - skopiuj ten plik jako ".env" i uzupelnij prawdziwymi danymi.
# Plik ".env" jest w .gitignore i nigdy nie trafia do repozytorium.

# Baza danych (MSSQL)
DB_SERVER=192.168.14.14
DB_NAME=produkcja
DB_USER=twoj_login
DB_PASSWORD=twoje_haslo

# Uzytkownik do montowania zasobu sieciowego (opcjonalny)
NETWORK_USER=uzytkownik
NETWORK_PASSWORD=haslo
